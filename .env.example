# =============================================================================
# MentorPulse - Environment Variables Template
# Copy this file to .env or .env.local and fill in your Supabase project credentials.
# If these are not provided, MentorPulse runs automatically in Interactive Demo Mode!
# =============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (safe to use in browser with RLS enabled)
# NEVER put service_role secret keys in browser environment variables!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Custom App Domain for Invitation Links (defaults to current window.location.origin)
VITE_APP_URL=http://localhost:5173
